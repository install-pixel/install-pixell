<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Звичайний дозвіл, надається автоматично; використовується лише після підтвердження. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Голосовий пошук: запитується лише при першому натисканні мікрофона. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Лише перевірка, чи є мережа, щоб без неї одразу взяти офлайн-розпізнавач. Дозволу INTERNET немає. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Видимість програм із меню запуску (Android 11+), без QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Служба розпізнавання мовлення та системне вікно голосового введення. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".BlackLaunchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlackLaunch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Домашній екран: з'являється у виборі лаунчера Android. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
