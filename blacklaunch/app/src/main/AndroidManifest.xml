<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Звичайний дозвіл, надається автоматично; використовується лише після підтвердження. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Голосовий пошук: запитується лише при першому натисканні мікрофона. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Глобальний пошук: запитуються лише коли користувач вмикає відповідне джерело. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Лише перевірка, чи є мережа, щоб без неї одразу взяти офлайн-розпізнавач. Дозволу INTERNET немає. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Видимість програм із меню запуску (Android 11+), без QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Служба розпізнавання мовлення та системне вікно голосового введення. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".BlackLaunchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlackLaunch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Домашній екран: з'являється у виборі лаунчера Android. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Імпорт офлайн-моделі голосу: «Відкрити за допомогою BlackLaunch» для zip-файлу. -->
        <activity
            android:name=".voice.ModelImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/models_section"
            android:theme="@style/Theme.BlackLaunch">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Плитка в шторці: перемикання профілю з будь-якої програми. -->
        <service
            android:name=".profiles.ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_profile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
