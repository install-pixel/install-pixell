    <string name="models_translation">Переклад</string>
    <string name="models_translation_hint">Потрібна для кнопки перекладу. Кожен напрямок — окремий файл; без нього цей напрямок не працює. Точні моделі перекладають помітно краще, але втричі більші й повільніші — для телефонів з 6 ГБ пам\'яті й більше.</string>
